# 自检/开发产物
# 注：devtools/ 从 1.1.1 接手起纳入版本控制（冒烟自检、上游对比、开发启动器），
# 以便后续维护者有可复用的验证手段。原上游把它排除在仓库外。
build/
dist/
*.spec
!package.spec
!package_mac.spec
*.egg-info/

# 开发/维护用的启动器：只留本地。它们调的是 devtools 里的脚本，
# 下载源码的人用不到；给用户的是 Start.bat / Install Python dependencies.bat / build_exe.bat
Start-debug.bat
Upload to GitHub.bat
Publish Release.bat

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/

# 工程/自动保存（属于个人数据，不进仓库）
*.rbarproj
*.rbarproj.autosave*
# 当前目录的应用设置文件（运行时自动生成，可按需手改）
rbar_settings.json
rbar_settings.json.tmp
skins/

# 编辑器 / 系统
.vscode/
.idea/
Thumbs.db
desktop.ini
*.log

# Windows 偶尔会在「当前目录」下建出没展开变量的字面量目录
# （跑新 exe 时冒出来的图标缓存 %SystemDrive%\ProgramData\Microsoft\Windows\Caches）
%SystemDrive%/
%SystemRoot%/
%ProgramData%/
%LOCALAPPDATA%/
%APPDATA%/
%TEMP%/
%*
