# 自检/开发产物（本地保留，不进仓库）
devtools/
build/
dist/
*.spec
*.egg-info/

# 开发/维护用的启动器：只留本地。它们调的是 devtools 里的脚本，
# 下载源码的人用不到；给用户的是 Start.bat / Install Python dependencies.bat / build_exe.bat
Start-debug.bat
Upload to GitHub.bat
Publish Release.bat

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/

# 工程/自动保存（属于个人数据，不进仓库）
*.rbarproj
*.rbarproj.autosave*

# 编辑器 / 系统
.vscode/
.idea/
Thumbs.db
desktop.ini
*.log

# Windows 偶尔会在「当前目录」下建出没展开变量的字面量目录
# （跑新 exe 时冒出来的图标缓存 %SystemDrive%\ProgramData\Microsoft\Windows\Caches）
%SystemDrive%/
%SystemRoot%/
%ProgramData%/
%LOCALAPPDATA%/
%APPDATA%/
%TEMP%/
%*
